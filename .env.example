# ────────────────────────────────────────────────────────────────────────────
# Eventi Cilento — variabili d'ambiente
# Copia questo file in .env.local e compila tutti i valori prima di avviare
# ────────────────────────────────────────────────────────────────────────────

# 1. ANTHROPIC — Chat AI e ricerca eventi automatica
# Ottieni la chiave su: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# 2. VERCEL KV (Redis) — Storage eventi, esperienze e proposte utenti
# Ottieni i valori su: https://vercel.com/dashboard → Storage → KV
# (in locale usa le credenziali del tuo KV database di sviluppo)
KV_REST_API_URL=https://xxx.kv.vercel-storage.com
KV_REST_API_TOKEN=xxx
KV_REST_API_READ_ONLY_TOKEN=xxx

# 3. SICUREZZA CRON — Protegge le route /api/cron* da chiamate non autorizzate
# Scegli una stringa casuale lunga almeno 32 caratteri
CRON_SECRET=cambia-con-una-stringa-segreta-lunga

# 4. TRIGGER KEY — Chiave per i trigger manuali degli aggiornamenti
TRIGGER_KEY=cambia-con-una-stringa-segreta-lunga
